# Next.js Environment Variables Example
# Copy this file to .env.local and fill in your actual values

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_API_TIMEOUT=5000

# Database Configuration (if using a database)
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Authentication
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here

# External Services
EXTERNAL_API_KEY=your-api-key-here
EXTERNAL_API_SECRET=your-api-secret-here

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_DEBUG=false

# Environment
NODE_ENV=development

# Build Configuration
NEXT_PUBLIC_BUILD_ID=local

# Image Optimization (if using external image domains)
# Add your image domains to next.config.js instead

# Notes:
# - Variables prefixed with NEXT_PUBLIC_ are exposed to the browser
# - Variables without NEXT_PUBLIC_ are server-only
# - Never commit .env.local to version control
# - Use .env.example to document required variables
