    "chromadb": "^1.9.2"
  },
  "devDependencies": {
    "@eggjs/tsconfig": "^1.3.3",
    "egg-bin": "^6.9.0",
    "egg-ts-helper": "^2.1.0",
    "typescript": "^5.5.0",
    "@types/node": "^22.0.0"
  }
}
